{
  "name": "@local/dsh-meeting-ears",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Listen to the system audio output, transcribe it locally, and send the merged speech to the conversation composer.",
  "license": "MIT",
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "speech-to-text", "wasapi", "sensevoice"],
  "repository": { "type": "git", "url": "git+https://github.com/AmirReeve/dsh-meeting-ears.git" },
  "homepage": "https://github.com/AmirReeve/dsh-meeting-ears#readme",
  "bugs": { "url": "https://github.com/AmirReeve/dsh-meeting-ears/issues" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "helper",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
