{
  "name": "dsh-meeting-ears",
  "version": "0.1.0",
  "description": "DeepSeek Harness bundle: transcribe the system audio output and your microphone locally, then send questions from the other side to the conversation.",
  "type": "module",
  "license": "MIT",
  "author": "AmirReeve",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "speech-to-text",
    "sensevoice",
    "wasapi",
    "loopback",
    "meeting"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmirReeve/dsh-meeting-ears.git"
  },
  "homepage": "https://github.com/AmirReeve/dsh-meeting-ears#readme",
  "bugs": { "url": "https://github.com/AmirReeve/dsh-meeting-ears/issues" },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "publishConfig": { "access": "public" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "helper/capture_helper.py",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
